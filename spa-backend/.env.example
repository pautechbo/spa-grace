PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=spa_consultorio_db2

# Obligatorio: sin esta variable el servidor no arranca.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (coma separada). Vacío = permitir todos.
CORS_ORIGIN=

# Solo para crear el esquema en un entorno NUEVO. Nunca en producción.
DB_SYNC=false
